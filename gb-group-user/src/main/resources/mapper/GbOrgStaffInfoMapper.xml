<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.com.shopgroup.user.mapper.GbOrgStaffInfoMapper">

    <!-- 员工信息表 -->
    <resultMap id="BaseResultMap" type="cn.com.shopgroup.user.model.GbOrgStaffInfo">
        <id column="staff_id" property="staffId"/>
        <result column="leader_id" property="leaderId"/>
        <result column="staff_name" property="staffName"/>
        <result column="mobile" property="mobile"/>
        <result column="nickname" property="nickname"/>
        <result column="avatar" property="avatar"/>
        <result column="openid" property="openid"/>
        <result column="remark" property="remark"/>
        <result column="auth_list" property="authList"/>
        <result column="is_close" property="isClose"/>
        <result column="add_time" property="addTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        staff_id
        , leader_id, staff_name, mobile, nickname, avatar, openid, remark, auth_list, is_close, add_time
    </sql>

    <delete id="removeStaff" parameterType="int">
        DELETE
        FROM gb_org_staff_info
        WHERE leader_id = #{leaderId}
          and staff_id = #{staffId}
    </delete>

</mapper>
