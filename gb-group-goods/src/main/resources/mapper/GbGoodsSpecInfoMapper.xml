<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="cn.com.shopgroup.goods.mapper.GbGoodsSpecInfoMapper">

    <!-- 商品规格信息表 -->
    <resultMap id="BaseResultMap" type="cn.com.shopgroup.goods.model.GbGoodsSpecInfo">
        <id column="spec_id" property="specId"/>
        <result column="goods_id" property="goodsId"/>
        <result column="leader_id" property="leaderId"/>
        <result column="spec_name" property="specName"/>
        <result column="is_price" property="isPrice"/>
        <result column="is_stock" property="isStock"/>
        <result column="sort_order" property="sortOrder"/>
        <result column="is_close" property="isClose"/>
        <result column="add_time" property="addTime"/>
    </resultMap>

    <sql id="Base_Column_List">
        spec_id, goods_id, leader_id, spec_name, is_price, is_stock, sort_order, is_close, add_time
    </sql>


    <!-- 按规格值id列表更新商品id -->
    <update id="updateGoodsIdByIds">
        UPDATE gb_goods_spec_info
        SET goods_id = #{goodsId}
        WHERE leader_id = #{leaderId}
        AND val_id IN
        <foreach collection="specValIds" item="valId" open="(" separator="," close=")">
            #{valId}
        </foreach>
    </update>

</mapper>
