<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <groupId>cn.com.shopgroup</groupId>
    <artifactId>GroupBuyApi</artifactId>
    <version>1.0.0-SNAPSHOT</version>
    <modules>
        <module>gb-group-common</module>
        <module>gb-group-gateway</module>
        <module>gb-group-user</module>
        <module>gb-group-goods</module>
        <module>gb-group-order</module>
        <module>gb-group-admin</module>
        <module>gb-group-task</module>
    </modules>
    <packaging>pom</packaging>

    <properties>
        <maven.compiler.source>8</maven.compiler.source>
        <maven.compiler.target>8</maven.compiler.target>
    </properties>

    <parent>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-starter-parent</artifactId>
        <version>2.7.18</version>
        <relativePath/>
    </parent>

    <dependencyManagement>
        <dependencies>
            <dependency>
                <groupId>org.springframework.cloud</groupId>
                <artifactId>spring-cloud-dependencies</artifactId>
                <version>2021.0.5</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
            <dependency>
                <groupId>com.alibaba.cloud</groupId>
                <artifactId>spring-cloud-alibaba-dependencies</artifactId>
                <version>2021.0.5.0</version>
                <type>pom</type>
                <scope>import</scope>
            </dependency>
        </dependencies>
    </dependencyManagement>

    <repositories>
        <repository>
            <id>public</id>
            <name>aliyun nexus</name>
            <url>https://maven.aliyun.com/repository/public</url>
            <releases>
                <enabled>true</enabled>
            </releases>
            <snapshots>
                <enabled>false</enabled>
            </snapshots>
        </repository>
    </repositories>

    <build>
        <pluginManagement>
            <plugins>
                <!--
                    多模块项目统一管理 spring-boot-maven-plugin。
                    默认跳过 repackage：保证 install 到本地仓库的是普通 jar（类位于 jar 根路径），
                    使 gb-group-goods / gb-group-order 等模块能正常依赖 gb-group-user / gb-group-goods。
                    各启动模块（user/gateway/goods/order/admin/task）已覆盖为 skip=false + classifier=exec：
                    package 时额外生成 <模块名>-exec.jar 可执行 jar（java -jar 部署用），
                    普通 jar 保留供模块间编译依赖，二者互不影响。
                -->
                <plugin>
                    <groupId>org.springframework.boot</groupId>
                    <artifactId>spring-boot-maven-plugin</artifactId>
                    <version>2.7.18</version>
                    <configuration>
                        <skip>true</skip>
                    </configuration>
                </plugin>
            </plugins>
        </pluginManagement>
    </build>

</project>